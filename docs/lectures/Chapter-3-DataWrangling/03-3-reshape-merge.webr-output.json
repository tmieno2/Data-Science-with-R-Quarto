{"cols":31,"rows":11,"plot":false},"flights":{"cols":78,"rows":17,"plot":false},"(\nnum_flights <- \n  flights %>% \n  group_by(carrier, month) %>% \n  summarize(num_obs = n())\n)":{"cols":24,"rows":15,"plot":false},"(\nnum_flights_wide <- \n  num_flights %>% \n  tidyr::pivot_wider(\n    names_from = month,\n    names_prefix = \"month_\",\n    values_from = num_obs\n  ) \n)":{"cols":74,"rows":22,"plot":false},"num_flights_wide %>%\n  tidyr::pivot_longer(\n    starts_with(\"month_\"),\n    names_to = \"month\",\n    names_prefix = \"month_\",\n    values_to = \"num_flights\"\n  )":{"cols":28,"rows":15,"plot":false},"select(price_data, price)":{"cols":10,"rows":5,"plot":false},"select(yield_data, yield)":{"cols":10,"rows":5,"plot":false},"select(price_data, price, county)":{"cols":20,"rows":5,"plot":false},"select(yield_data, yield, county)":{"cols":20,"rows":5,"plot":false},"select(price_data, price, county, year)":{"cols":25,"rows":5,"plot":false},"select(yield_data, yield, county, year)":{"cols":25,"rows":5,"plot":false},"price_data":{"cols":25,"rows":5,"plot":false},"yield_data":{"cols":25,"rows":5,"plot":false},"left_join(yield_data, price_data, by = c(\"county\", \"year\"))":{"cols":34,"rows":5,"plot":false},"left_join(price_data, yield_data, by = c(\"county\", \"year\"))":{"cols":34,"rows":5,"plot":false},"(\nyield_data_with_chase <- \n  data.frame(\n    yield = runif(6, min = 180, max = 280),\n    county = c(\"Lancaster\", \"Douglas\", \"Chase\", \"Lancaster\", \"Douglas\", \"Chase\"),\n    year = c(2015, 2015, 2015, 2016, 2016, 2016)\n  )\n)":{"cols":25,"rows":7,"plot":false},"left_join(price_data, yield_data_with_chase, by = c(\"county\", \"year\"))":{"cols":34,"rows":5,"plot":false},"left_join(yield_data_with_chase, price_data, by = c(\"county\", \"year\"))":{"cols":34,"rows":7,"plot":false},"full_join(price_data, yield_data_with_chase, by = c(\"county\", \"year\"))":{"cols":34,"rows":7,"plot":false},"( \nweather_data <- \n  data.frame(\n    rainfall = 20 * runif(12),\n    county = rep(c(\"Lancaster\", \"Douglas\", \"Chase\"), each = 4),\n    year = rep(c(2015, 2016), each = 2) %>% rep(3),\n    month = rep(c(4, 5), 6)\n  ) \n)":{"cols":33,"rows":13,"plot":false},"left_join(yield_data, weather_data, by = c(\"county\", \"year\"))":{"cols":41,"rows":9,"plot":false},"yield_data <- \n  data.frame(\n    yield = c(runif(4, min = 180, max = 280), runif(4, min = 40, max = 80)),\n    county = rep(c('Lancaster','Douglas','Lancaster','Douglas'), 2),\n    year = rep(c(2015, 2015, 2016, 2016), 2),\n    crop = c(rep(\"Corn\", 4), rep(\"Soybean\", 4))\n  )":{"cols":0,"rows":0,"plot":false},"left_join(yield_data, weather_data, by = c(\"county\", \"year\"))\n# left_join(yield_data, weather_data, by = c(\"county\", \"year\"), relationship = \"many-to-many\")":{"cols":51,"rows":17,"plot":false},"(\n  flights_Jan <- \n    flights %>% \n    filter(month == 1) %>% \n    select(month, day, dep_delay, origin)\n)":{"cols":31,"rows":14,"plot":false},"(\n  daily_temp_Jan <- \n    weather %>% \n    filter(month == 1) %>% \n    group_by(origin, month, day) %>% \n    summarize(temp = mean(temp))\n)":{"cols":29,"rows":15,"plot":false},"(\n  hourly_temp_Jan <- \n    weather %>% \n    filter(month == 1) %>% \n    select(origin, month, day, hour, temp) \n)":{"cols":33,"rows":14,"plot":false},"left_join(flights_Jan, daily_temp_Jan, by = c(\"origin\", \"month\", \"day\"))":{"cols":37,"rows":14,"plot":false},"left_join(flights_Jan, hourly_temp_Jan, by = c(\"origin\", \"month\", \"day\"), relationship = \"many-to-many\")":{"cols":43,"rows":14,"plot":false},"jan_flights <-\n  flights %>%\n  filter(month == 1) %>%\n  select(origin, dep_time = time_hour, dep_delay)\n\njan_weather <-\n  weather %>%\n  filter(month == 1) %>%\n  select(origin, obs_time = time_hour, temp)":{"cols":0,"rows":0,"plot":false},"matched <- left_join(jan_flights, jan_weather, join_by(origin, dep_time == obs_time))\n\nnrow(matched)              # every flight is still here\nsum(is.na(matched$temp))   # ...but how many have no temperature?":{"cols":9,"rows":2,"plot":false},"matched %>%\n  filter(is.na(temp)) %>%\n  count(origin, dep_time)":{"cols":34,"rows":6,"plot":false},"readings <- data.frame(\n  field     = c(\"A\", \"A\", \"A\", \"B\", \"B\"),\n  read_date = as.Date(c(\"2024-05-01\", \"2024-05-10\", \"2024-05-20\", \"2024-05-05\", \"2024-05-15\")),\n  moisture  = c(30, 22, 35, 28, 19)\n)\n\nirrigation <- data.frame(\n  field      = c(\"A\", \"A\", \"B\", \"B\"),\n  irrig_date = as.Date(c(\"2024-05-08\", \"2024-05-22\", \"2024-05-14\", \"2024-05-02\")),\n  inches     = c(1.0, 0.8, 1.2, 0.5)\n)":{"cols":0,"rows":0,"plot":false},"readings":{"cols":27,"rows":6,"plot":false},"irrigation":{"cols":25,"rows":5,"plot":false},"left_join(irrigation, readings, by = \"field\", relationship = \"many-to-many\")":{"cols":46,"rows":11,"plot":false},"left_join(irrigation, readings, join_by(field, irrig_date >= read_date))":{"cols":45,"rows":7,"plot":false},"left_join(irrigation, readings, join_by(field, closest(irrig_date >= read_date)))":{"cols":45,"rows":5,"plot":false},"#--- most recent reading at or BEFORE (roll backward) ---#\nleft_join(irrigation, readings, join_by(field, closest(irrig_date >= read_date)))":{"cols":45,"rows":5,"plot":false},"#--- first reading at or AFTER (roll forward) ---#\nleft_join(irrigation, readings, join_by(field, closest(irrig_date <= read_date)))":{"cols":45,"rows":5,"plot":false},"rolled <- left_join(jan_flights, jan_weather, join_by(origin, closest(dep_time >= obs_time)))\n\nnrow(rolled)              # same number of flights\nsum(is.na(rolled$temp))   # ...and now?":{"cols":9,"rows":2,"plot":false},"nearest <-\n  irrigation %>%\n  #--- step 1: the previous reading ---#\n  left_join(readings, join_by(field, closest(irrig_date >= read_date))) %>%\n  rename(date_before = read_date, moisture_before = moisture) %>%\n  #--- step 2: the next reading ---#\n  left_join(readings, join_by(field, closest(irrig_date <= read_date))) %>%\n  rename(date_after = read_date, moisture_after = moisture) %>%\n  #--- step 3: measure both gaps and keep the smaller ---#\n  mutate(\n    gap_before = as.numeric(irrig_date - date_before),\n    gap_after  = as.numeric(date_after - irrig_date)\n  ) %>%\n  mutate(\n    moisture = ifelse(\n      is.na(gap_after) | (!is.na(gap_before) & gap_before <= gap_after),\n      moisture_before,\n      moisture_after\n    )\n  )\n\nnearest":{"cols":79,"rows":10,"plot":false},"select(nearest, field, irrig_date, gap_before, gap_after, moisture)":{"cols":48,"rows":5,"plot":false},"tie_irrig <- data.frame(field = \"A\", irrig_date = as.Date(\"2024-05-10\"), inches = 1)\ntie_read  <- data.frame(\n  field     = \"A\",\n  read_date = as.Date(c(\"2024-05-05\", \"2024-05-15\")),\n  moisture  = c(24, 31)\n)\n\n#--- one row each: the inequality picks the side, then closest() picks within it ---#\nleft_join(tie_irrig, tie_read, join_by(field, closest(irrig_date >= read_date)))\nleft_join(tie_irrig, tie_read, join_by(field, closest(irrig_date <= read_date)))":{"cols":45,"rows":4,"plot":false},"dup_read <- data.frame(\n  field     = \"A\",\n  read_date = as.Date(c(\"2024-05-05\", \"2024-05-05\")),\n  moisture  = c(24, 31)\n)\n\n#--- one row in, TWO rows out ---#\nleft_join(tie_irrig, dup_read, join_by(field, closest(irrig_date >= read_date)))":{"cols":45,"rows":3,"plot":false},"result <- left_join(irrigation, readings, join_by(field, closest(irrig_date >= read_date)))\n\n#--- how many failed to match? ---#\nsum(is.na(result$read_date))":{"cols":5,"rows":1,"plot":false},"planting <- data.frame(\n  field      = c(\"A\", \"B\", \"C\"),\n  plant_date = as.Date(c(\"2024-04-20\", \"2024-05-02\", \"2024-05-25\"))\n)\n\nrain <- data.frame(\n  field     = c(\"A\", \"A\", \"B\", \"B\", \"C\"),\n  rain_date = as.Date(c(\"2024-04-18\", \"2024-04-27\", \"2024-05-06\", \"2024-05-19\", \"2024-05-10\")),\n  inches    = c(0.4, 1.1, 0.7, 2.0, 1.5)\n)":{"cols":0,"rows":0,"plot":false},"planting":{"cols":18,"rows":4,"plot":false},"rain":{"cols":25,"rows":6,"plot":false},"left_join(planting, rain, join_by(field, closest(plant_date <= rain_date)))":{"cols":36,"rows":4,"plot":false},"planting %>%\n  left_join(rain, join_by(field, closest(plant_date >= rain_date))) %>%\n  rename(date_before = rain_date, inches_before = inches) %>%\n  left_join(rain, join_by(field, closest(plant_date <= rain_date))) %>%\n  rename(date_after = rain_date, inches_after = inches) %>%\n  mutate(\n    gap_before = as.numeric(plant_date - date_before),\n    gap_after  = as.numeric(date_after - plant_date)\n  ) %>%\n  select(field, plant_date, date_before, gap_before, date_after, gap_after)":{"cols":62,"rows":4,"plot":false}}
